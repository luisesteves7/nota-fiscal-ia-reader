# ============================================================
# Copie este arquivo para ".env.local" e preencha com valores reais.
# NUNCA commite ".env.local" (já está no .gitignore).
# ============================================================

# --- Supabase ---------------------------------------------------
# Painel do projeto -> Project Settings -> API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave "service_role" — tem acesso total, ignora RLS.
# Usar SOMENTE em código de servidor (rotas de API), nunca no client.
# Mesma tela do Supabase, campo "service_role".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- IA (extração de dados da nota fiscal) -----------------------
# Chave da Groq (usada em src/lib/ai/extract-invoice.ts)
# Gerar em https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- App -----------------------------------------------------------
# Usado para montar links absolutos (ex: compartilhar/relatar erro)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Liga o "modo demo": usa notas fictícias da pasta /examples em vez de
# chamar a API de verdade. Deixe "true" no deploy público para não
# gastar sua cota de API. Deixe "false" localmente quando quiser
# testar a extração real.
NEXT_PUBLIC_DEMO_MODE=false
